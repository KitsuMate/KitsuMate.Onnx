# Generated UPM archives are release artifacts, never repository contents.
Artifacts/
TestResults/
Packages/ai.kitsumate.onnx.backend.onnxruntime/Runtime/Plugins/**
!Packages/ai.kitsumate.onnx.backend.onnxruntime/Runtime/Plugins/**/
!Packages/ai.kitsumate.onnx.backend.onnxruntime/Runtime/Plugins/**/*.meta
!Packages/ai.kitsumate.onnx.backend.onnxruntime/Runtime/Plugins/Android.meta
!Packages/ai.kitsumate.onnx.backend.onnxruntime/Runtime/Plugins/Android/
!Packages/ai.kitsumate.onnx.backend.onnxruntime/Runtime/Plugins/Android/**/
!Packages/ai.kitsumate.onnx.backend.onnxruntime/Runtime/Plugins/Android/**/*.meta

# Native payload bytes are provisioned from checksum locks. Unity-generated
# importer metadata is source-controlled so clean release archives retain the
# reviewed platform filters before any consumer import occurs.
!Packages/ai.kitsumate.onnx.backend.onnxruntime.nvidia/Runtime/Plugins/**/
!Packages/ai.kitsumate.onnx.backend.onnxruntime.nvidia/Runtime/Plugins/**/*.meta

# Unity cannot open the UPM-convention `ExampleProject~` directory directly.
# CI and local batch runs stage this ignored, openable copy before invoking Unity.
ExampleProject/

# Core may vendor the small, reviewed managed tokenizer contract DLLs after the
# KitsuMate.Tokenizers v1.0.0 release. Native runtime binaries remain ignored.
!Packages/ai.kitsumate.onnx/Runtime/Plugins/Managed/*.dll

# The core UPM package name itself ends in .onnx; do not mistake its directory
# for a model artifact. Individual model files remain ignored by the rules above.
!Packages/ai.kitsumate.onnx/
!Packages/ai.kitsumate.onnx/**/
!Packages/ai.kitsumate.onnx/**/*.cs
!Packages/ai.kitsumate.onnx/**/*.asmdef
!Packages/ai.kitsumate.onnx/**/*.json
!Packages/ai.kitsumate.onnx/**/*.md
!Packages/ai.kitsumate.onnx/**/*.meta
